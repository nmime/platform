# Huly GitLab external integration pod
PORT=3570
SERVICE_ID=gitlab-service

# GitLab instance and credentials. Webhook ingestion works without a token;
# API-helper/readiness endpoints need a token with read_api scope (api scope for writes if you use client write helpers).
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_TOKEN_TYPE=pat
GITLAB_READINESS_PROJECT=

# GitLab webhook validation. Keep REQUIRED=true in production and set the same secret in GitLab.
GITLAB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET_REQUIRED=true
GITLAB_MAX_WEBHOOK_BODY_BYTES=1048576
GITLAB_LOG_PAYLOADS=false

# Optional shared secret for Huly/internal callers of GET /api/v1/* helper endpoints.
SERVER_SECRET=

# Huly delivery adapters. Configure one or more. If none are set the pod still starts
# and logs gitlab.delivery.no-adapter; valid webhooks are normalized but not persisted.
# 1) Exact generic webhook URL; called exactly as configured.
HULY_WEBHOOK_URL=
HULY_TOKEN=

# 2) MCP base URL; pod POSTs to ${HULY_MCP_BASE_URL}/tools/huly_gitlab_upsert.
HULY_MCP_BASE_URL=
HULY_MCP_TOKEN=

# 3) Huly API base URL; pod POSTs to ${HULY_API_BASE_URL}/api/integrations/gitlab/upsert.
HULY_API_BASE_URL=
HULY_API_TOKEN=

# Optional workspace metadata included in delivery payloads.
HULY_DEFAULT_WORKSPACE=
